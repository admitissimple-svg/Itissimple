rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'adm.itissimple@gmail.com' ||
        request.auth.token.email == 'admin@itissimple.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection - strictly partitioned by UID with fallback for unauthenticated registration sync
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin() || request.auth == null;
    }

    // App state synchronization document for persistent backend storage across restarts
    match /app_state/{docId} {
      allow read, write: if true;
    }

    // Native Friend / Tutor profiles
    match /tutors/{tutorId} {
      allow read: if resource.data.approvalStatus == 'approved' ||
                     isAdmin() ||
                     (isAuthenticated() && (
                       resource.data.uid == request.auth.uid ||
                       resource.data.email == request.auth.token.email
                     ));
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow delete: if isAdmin();
    }

    // Live lessons - strictly isolated to student, teacher, or admin
    match /lessons/{lessonId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.studentEmail == request.auth.token.email ||
          resource.data.teacherUid == request.auth.uid ||
          resource.data.teacherEmail == request.auth.token.email
        )
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.studentEmail == request.auth.token.email ||
        request.resource.data.teacherUid == request.auth.uid ||
        request.resource.data.teacherEmail == request.auth.token.email ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.studentEmail == request.auth.token.email ||
          resource.data.teacherUid == request.auth.uid ||
          resource.data.teacherEmail == request.auth.token.email
        )
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.teacherUid == request.auth.uid
        )
      );
    }

    // Routines per user
    match /routines/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
