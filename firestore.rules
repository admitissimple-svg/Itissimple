rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'estilobeeforkids@gmail.com' ||
        request.auth.token.email == 'estilobeeadm@gmail.com' ||
        request.auth.token.email == 'adm.itissimple@gmail.com' ||
        request.auth.token.email == 'admin@itissimple.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection - strictly partitioned by UID with fallback for unauthenticated registration sync
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin() || request.auth == null;

      // Student current routine subcollection for real-time Spotify daily track & teacher feedback
      match /currentRoutine/{weekId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin() || request.auth == null || isAuthenticated();
      }

      // Consolidated weekly history subcollection (consumedVideoIds, consumedTrackIds, weeklyVocabulary)
      match /weeklyHistory/{weekId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin() || request.auth == null || isAuthenticated();
      }

      // Student daily routine subcollection for video, topic selection, and teacher Spotify override track (teacherOverrideTrack)
      match /routines/{dayOfWeek} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin() || request.auth == null || isAuthenticated();
      }
    }

    // App state synchronization document for persistent backend storage across restarts
    match /app_state/{docId} {
      allow read, write: if true;
    }

    // Native Friend / Tutor profiles
    match /tutors/{tutorId} {
      allow read: if resource.data.approvalStatus == 'approved' ||
                     isAdmin() ||
                     (isAuthenticated() && (
                       resource.data.uid == request.auth.uid ||
                       resource.data.email == request.auth.token.email
                     ));
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow delete: if isAdmin();
    }

    // Live lessons - strictly isolated to student, teacher, or admin
    match /lessons/{lessonId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.studentEmail == request.auth.token.email ||
          resource.data.teacherUid == request.auth.uid ||
          resource.data.teacherEmail == request.auth.token.email
        )
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.studentEmail == request.auth.token.email ||
        request.resource.data.teacherUid == request.auth.uid ||
        request.resource.data.teacherEmail == request.auth.token.email ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.studentEmail == request.auth.token.email ||
          resource.data.teacherUid == request.auth.uid ||
          resource.data.teacherEmail == request.auth.token.email
        )
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.teacherUid == request.auth.uid
        )
      );
    }

    // Routines per user
    match /routines/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Student Media Assignments per UID (YouTube & Spotify)
    match /student_assignments/{userId} {
      allow read, write: if isOwner(userId) || isAdmin() || request.auth == null;
    }

    // Teacher availability schedule per UID / document
    match /teacher_availability/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin() || request.auth == null;
    }

    // Direct Messages & Notices - strictly exclusive to student and active native friend
    match /direct_messages/{messageId} {
      allow read: if isAdmin() || request.auth == null || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.nativeFriendUid == request.auth.uid ||
          resource.data.studentEmail == request.auth.token.email ||
          resource.data.nativeFriendEmail == request.auth.token.email
        )
      );
      allow create: if isAdmin() || request.auth == null || (
        isAuthenticated() && (
          request.resource.data.studentUid == request.auth.uid ||
          request.resource.data.nativeFriendUid == request.auth.uid ||
          request.resource.data.senderUid == request.auth.uid ||
          request.resource.data.senderEmail == request.auth.token.email
        )
      );
      allow update: if isAdmin() || request.auth == null || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.nativeFriendUid == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }
  }
}
